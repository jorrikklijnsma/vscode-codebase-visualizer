{
  "name": "vscode-codebase-visualizer",
  "displayName": "Codebase Visualizer",
  "description": "Visualize your VueJS codebase with control flow and architecture diagrams",
  "version": "0.0.1",
  "engines": {
    "vscode": "^1.60.0"
  },
  "categories": [
    "Visualization",
    "Other"
  ],
  "activationEvents": [],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "codebase-visualizer.generateControlFlow",
        "title": "Generate Control Flow Diagram"
      },
      {
        "command": "codebase-visualizer.generateArchitecture",
        "title": "Generate Architecture Diagram"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "codebase-visualizer",
          "title": "Codebase Visualizer",
          "icon": "resources/visualizer-icon.svg"
        }
      ]
    },
    "views": {
      "codebase-visualizer": [
        {
          "type": "webview",
          "id": "codebaseVisualizerView",
          "name": "Codebase Visualizer"
        }
      ]
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "pretest": "npm run compile && npm run lint",
    "lint": "eslint src --ext ts",
    "test": "node ./out/test/runTest.js"
  },
  "devDependencies": {
    "@babel/types": "^7.25.2",
    "@types/babel__parser": "^7.0.0",
    "@types/babel__traverse": "^7.20.6",
    "@types/glob": "^8.1.0",
    "@types/mocha": "^10.0.1",
    "@types/node": "^18.15.11",
    "@types/vscode": "^1.60.0",
    "@typescript-eslint/eslint-plugin": "^5.56.0",
    "@typescript-eslint/parser": "^5.56.0",
    "eslint": "^8.36.0",
    "glob": "^8.1.0",
    "mocha": "^10.2.0",
    "typescript": "^5.0.2",
    "vscode-test": "^1.6.1"
  },
  "dependencies": {
    "@babel/parser": "^7.21.4",
    "@babel/traverse": "^7.21.4"
  }
}
